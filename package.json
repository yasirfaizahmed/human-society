{
  "name": "human-society",
  "private": true,
  "version": "0.1.0",
  "description": "Agent-based simulation of a human society: individuals, families, economy, faith, politics and history-shaping events.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "headless": "tsx scripts/headless.ts",
    "sweep": "tsx scripts/sweep.ts",
    "groups": "tsx scripts/groups.ts",
    "fit-countries": "tsx scripts/fit-countries.ts",
    "country-data": "python3 scripts/country-data/build.py"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
